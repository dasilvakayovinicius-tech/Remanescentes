{
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/biosite",
      "destination": "/biosite/index.html"
    },
    {
      "source": "/painel",
      "destination": "/painel/index.html"
    },
    {
      "source": "/confirmacao",
      "destination": "/confirmacao/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}